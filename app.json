{
  "expo": {
    "name": "NAYQO",
    "slug": "nayqo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nayqo",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "NAYQO",
      "shortName": "NAYQO",
      "themeColor": "#0A0A0A",
      "backgroundColor": "#0A0A0A"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "声で入力するために、マイクを使います。（NAYQO uses the microphone for voice input.）"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "写真をNAYQOに見せるために、写真へのアクセスを使います。（NAYQO accesses your photos so you can send them.）",
          "cameraPermission": "写真を撮ってNAYQOに見せるために、カメラを使います。（NAYQO uses the camera so you can send photos.）",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#000000"
  }
}
