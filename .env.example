# このファイルをコピーして「.env.local」という名前にし、値を入れてください。
# .env.local は GitHub に上がらない設定になっています。
#
# ここに書くのは「公開しても安全な値」だけです。
# OpenAI の APIキーは絶対にここに書かないでください（Supabase の Secrets に入れます）。

# Supabase → Project Settings → API（または Data API）にある Project URL
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys にある Publishable key（sb_publishable_... ）
# 古い形式の anon key（eyJ... で始まる長い文字）でも動きます
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
